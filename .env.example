# AWS — picked up by aws-config automatically. Either set these or use a
# named profile via AWS_PROFILE / shared credentials file.
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=eu-central-1
# AWS_PROFILE=

# GitHub — used by aws-utils for compare/contents/release calls.
# If unset, aws-utils falls back to `gh auth token` (requires gh CLI).
# GITHUB_TOKEN=

# JIRA — required by `changelog` and `release` to enrich ticket keys
# found in commit messages.
# JIRA_BASE_URL=https://mindtwo.atlassian.net
# JIRA_EMAIL=you@mindtwo.de
# JIRA_API_TOKEN=
